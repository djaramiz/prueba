///$tab Main
SET ThousandSep='.';
SET DecimalSep=',';
SET MoneyThousandSep='.';
SET MoneyDecimalSep=',';
SET MoneyFormat='$ #.##0;-$ #.##0';
SET TimeFormat='h:mm:ss TT';
SET DateFormat='D/MM/YYYY';
SET TimestampFormat='D/MM/YYYY h:mm:ss[.fff] TT';
SET FirstWeekDay=6;
SET BrokenWeeks=1;
SET ReferenceDay=0;
SET FirstMonthOfYear=1;
SET CollationLocale='es-CO';
SET CreateSearchIndexOnReload=1;
SET MonthNames='ene.;feb.;mar.;abr.;may.;jun.;jul.;ago.;sep.;oct.;nov.;dic.';
SET LongMonthNames='enero;febrero;marzo;abril;mayo;junio;julio;agosto;septiembre;octubre;noviembre;diciembre';
SET DayNames='lun.;mar.;mié.;jue.;vie.;sáb.;dom.';
SET LongDayNames='lunes;martes;miércoles;jueves;viernes;sábado;domingo';
SET NumericalAbbreviation='3:k;6:M;9:G;12:T;15:P;18:E;21:Z;24:Y;-3:m;-6:μ;-9:n;-12:p;-15:f;-18:a;-21:z;-24:y';


LET vRutaQVDExtraccionXlsx = '\\epm-file02\aplic\Service_Desk\Remedy_epm\Auditoria\Evaluación vigente\';//cargar
LET vRutaQVDExtraccion = '\\epm-file02\aplic\DGYD\DerechosAutor\QVD\Extracted\'; //guardar


///$tab CONEXION JDE
LIB CONNECT TO 'CONEXION_ONEWORLD (epm_dcarmond)';

///$tab 1.1. Activos_OneWorld
// Todos los activos
Activos_OneWorld: 
select
to_char(rtrim(ltrim(FAASID))) as "[FAASID] - Serial Number",
FADSP as "[FADSP] - Date Retired",
PDDTAEPM.JULIANOAGREG(FADSP) as "[FADSP] - Date Disposed or Retired",
FANUMB as "[FANUMB] - Asset Number",
FAAAID as "[FAAAID] - Parent Number",
FAAFE as "[FAAFE] - AFE Number",
FAADDS as "[FAADDS] - State",
FAAOBJ as "[FAAOBJ] - Asset Cost Account - Object",
FADL01 as "[FADL01] - Description",
FADL02 as "[FADL02] - Description 02",
FADL03 as "[FADL03] - Description 03",
FADSCC as "[FADSCC] - Compressed Description",
FACO as "[FACO] - Company",
FAAPID as "[FAAPID] - Unit Number",
FASEQ as "[FASEQ] - Sequence Number",
FAACL1 as "[FAACL1] - Major Accounting Class",
FAACL2 as "[FAACL2] - Major Equipment Class",
FAACL3 as "[FAACL3] - Manufacturer",
FAACL4 as "[FAACL4] - Model Year",
FAACL5 as "[FAACL5] - Usage Miles or Hours",
FADSUB as "[FADSUB] - Accum Depr Acct - Subsidiary",
FAXMCU as "[FAXMCU] - Depreciation Exp - BU",
FAXOBJ as "[FAXOBJ] - Depreciation Exp - Object",
FAXSUB as "[FAXSUB] - Depreciation Exp - Subsidiary",
FAJCD as "[FAJCD] - Contract Date",
PDDTAEPM.JULIANOAGREG(FADEXJ) as "[FADEXJ] - Date Expired",
FAINSP as "[FAINSP] - Policy Number",
FAINSC as "[FAINSC] - Insurance Company",
FAINSM as "[FAINSM] - Renewal Month",
FAINSA as "[FAINSA] - Insurance Premium",
FAAIV as "[FAAIV] - Insurance Value",
FAINSI as "[FAINSI] - Value Index (future)",
FAUSER as "[FAUSER] - User ID",
PDDTAEPM.JULIANOAGREG(FALCT) as "[FALCT] - Date Last Changed",
FAMCU as "[FAMCU] - Business Unit",
FALOC as "[FALOC] - Location",
PDDTAEPM.JULIANOAGREG(FADAJ) as "[FADAJ] - Date Acquired",
FAEQST as "[FAEQST] - Equipment Status",
FANORU as "[FANORU] - New or Used on Acquisition",
FAAESV as "[FAAESV] - Estimated Salvage Value",
FAARPC as "[FAARPC] - Replacement Cost",
FAWOYN as "[FAWOYN] - Allow Work Order",
FACRTL as "[FACRTL] - Criticality",
FAWRFL as "[FAWRFL] - Warranty Flag",
FAWARJ as "[FAWARJ] - Warranty Expiration"

FROM PDDTAEPM.F1201;
/*--where
--FAAOBJ = '167002'
--AND (FADL01 like '%COMPUTADOR%' or FADL01 like '%WORKSTATION%')
--AND FADSP = 0*/

Store Activos_OneWorld into [$(vRutaQVDExtraccion)Activos_OneWorld.qvd](qvd);
Drop Table Activos_OneWorld;

///$tab 1.2. informe_computer_system_all
informe_computer_system_all:
LOAD
    Instancia,
    "Fecha de último examen",
    "Ultima Modificacion",
    "Numero Serial",
    "Nombre CI",
    "Numero Activo",
    "Rol del sistema",
    "Estado Manual (Estado)",
    "Motivo Estado Manual",
    "Estado CM",
    "Motivo del Estado CM",
    "Categoria (Nivel 1)" as Categoria_Nivel_1,
    "Tipo (Nivel 2)" as Tipo_Nivel_2,
    "Item (Nivel 3)" as Item_Nivel_3,
    "Modelo (Nombre de producto+)" as Modelo_Nombre_producto,
    Fabricante,
    Contrato,
    "Empresa Suministradora",
    "Fecha Compra (Fecha adquisicion)",
    "Fecha Inicio Garantia",
    "Fecha Fin Garantia",
    "Fecha Inventario",
    "Fecha Repotenciacion",
    "Contacto Primario",
    "Contacto Propietario",
    Cedula,
    LOGIN,
    Correo,
    "Centro de Costos",
    "Nombre Centro de Costos",
    "Departamento CI",
    Organizacion,
    Empresa_Propietaria,
    Filial,
    "Region (Zona)",
    "Site Group (Grupo Ubicaciones)",
    "Site o Edificio (Ubicación)",
    Piso,
    "Empresa Sede"
//FROM [lib://EPM_File_02 (epm_dcarmond)/Service_Desk/Remedy_epm/Auditoria/Evaluación vigente/informe_computer_system_all.xlsx]
//(ooxml, embedded labels, table is [informe_computer_system_all - 1]);

FROM [$(vRutaQVDExtraccionXlsx)informe_computer_system_all.xlsx]
(ooxml, embedded labels, table is [informe_computer_system_all]);

Store informe_computer_system_all into [$(vRutaQVDExtraccion)informe_computer_system_all.qvd](qvd);
Drop Table informe_computer_system_all;
///$tab 1.3. InventarioServidoresWindows
// MIGRACIÓN: hoja [Reporte Inventario Servidores] → [Windows]
// Campos eliminados: Dominio, Agente SCCM, Agente MCM
// Campos renombrados: name→Servidor, os→OS
// Campos nuevos: ip, power_state, ambiente, os_generico, ubicacion, origen, comunidad_principal
InventarioServidoresWindows:
LOAD
    name        as Servidor,
    ip,
    power_state,
    ambiente,
    os          as OS,
    os_generico,
    ubicacion,
    origen,
    comunidad_principal

// FROM [lib://EPM_File_02 (epm_dcarmond)/Service_Desk/Remedy_epm/Auditoria/Evaluación vigente/InventarioServidoresWindows.xlsx]
// (ooxml, embedded labels, table is [Reporte Inventario Servidores]);

FROM [$(vRutaQVDExtraccionXlsx)InventarioServidoresWindows.xlsx]
(ooxml, embedded labels, table is [Windows]);


Store InventarioServidoresWindows into [$(vRutaQVDExtraccion)InventarioServidoresWindows.qvd](qvd);
Drop Table InventarioServidoresWindows;
///$tab 1.4. InventarioServidoresNoWindows
// MIGRACIÓN: hoja [Hoja1] → [NoWindows]; campos actualizados al nuevo formato del archivo
InventarioServidoresNoWindows:
LOAD
    name        as NOMBRE,
    ip,
    power_state,
    ambiente    as AMBIENTE,
    os          as "SISTEMA OPERATIVO",
    os_generico
//FROM [lib://EPM_File_02 (epm_dcarmond)/Service_Desk/Remedy_epm/Auditoria/Evaluación vigente/InventarioServidoresNoWindows.xlsx]
//(ooxml, embedded labels, table is [Hoja1]);  // hoja y campos anteriores - ya no existen

FROM [$(vRutaQVDExtraccionXlsx)InventarioServidoresNoWindows.xlsx]
(ooxml, embedded labels, table is [NoWindows]);

Store InventarioServidoresNoWindows into [$(vRutaQVDExtraccion)InventarioServidoresNoWindows.qvd](qvd);
Drop Table InventarioServidoresNoWindows;
///$tab 2.1.CMDB_ContratosVsLicencias
