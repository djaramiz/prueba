///$tab 2.3. SW_listablanca
// MIGRACIÓN: archivo → REV_2023_02_SW gratuito lista blanca - lista negra.xlsx
// Campos nuevos: WO, NOMBRE SW (antes SW), VERSION EN RUTA, FECHA REVISION, ESTADO, URL, Observaciones
// Campos eliminados: Análisis, Fecha Análisis
//SW_listablanca:
//LOAD
