AdministradorLocal:
LOAD
    "Computer Name",
    "Name of the local Group",
    "Account Contained within the Group",
    "Account Type",
    "Domain for Account",
    "Type of Account",
    "User Loged On"
//FROM [lib://EPM_File_02 (epm_dcarmond)/Service_Desk/Remedy_epm/Auditoria/Evaluación vigente/AdministradorLocal.xlsx]
