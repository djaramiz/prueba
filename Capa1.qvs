///$tab 4. SWDardeBaja
// MIGRACIÓN: todos los campos cambiaron al nuevo formato (exportación BMC Remedy distinta).
// Campos eliminados (sin equivalente): WOI_CI, Service, Product Cat Tier 1/2/3,
//   Service Cat Tier 1/2/3, Sequence, StatusReasonSelection, Customer First/Last Name, Business Service.
// Nuevo campo clave: Número (antes Work Order ID). WOI_CI no disponible → TODO: evaluar impacto en dashboard.
//SWDardeBaja:  // estructura ANTERIOR
//LOAD
//    "Work Order ID",
//    "Categorization Tier 2",
//    Summary,
//    "Status WO",
//    "Submit Date",
//    "Completed Date",
//    Notes,
//    "Request Assignee",
//    ASGRP,
//    WOI_CI,          // NO DISPONIBLE en nuevo formato
//    Service,         // NO DISPONIBLE en nuevo formato
//    "Categorization Tier 1",
//    "Categorization Tier 3",
//    ...
//FROM [$(vRutaQVDExtraccionXlsx)SWDardeBaja.xlsx]
//(ooxml, embedded labels, table is [SWDardeBaja]);

SWDardeBaja:
LOAD
    Tipo,
    Número                             as "Work Order ID",
    "ID Tarea"                         as "Task ID",
    Estado                             as "Status WO",
    Prioridad,
    "Fecha de Creación OC"             as "Submit Date",
    "Fecha de Cierre OC"              as "Completed Date",
    "Mes apertura",
    "Año apertura",
    "Horas Laboradas",
    "Grupo Asignado"                   as ASGRP,
    "Categoria Operacional Nivel 1 OC" as "Categorization Tier 1",
    "Categoria Operacional Nivel 2 OC" as "Categorization Tier 2",
    "Categoria Operacional Nivel 3 OC" as "Categorization Tier 3",
    "Nombre de la tarea"               as Summary,
    Notas                              as Notes,
    "Estado Tarea"                     as Status,
    "Usuario Afectado",
    "Remedy Login ID",
    Company,
    "Assigned To",
    "Usuario Asignado"                 as Assignee,
    "Grupo Asignado.1"                 as "Assignee Group",
    Área                               as Department,
    "Fecha de activación"              as "Inicia Asignación Tarea",
    "Fecha de finalización"            as "Termina Asignación Tarea",
    "Notas OC",
    "Minutos Tareas"                   as "Total Minutos Activo Tarea",
    "Horas Tareas"                     as "Total Horas Activo Tarea",
    "Horas Resolución OC"             as "Total Horas Activo WO",
    "Última modificación"
FROM [$(vRutaQVDExtraccionXlsx)SWDardeBaja.xlsx]
(ooxml, embedded labels, table is [Hoja1]);

Store SWDardeBaja into [$(vRutaQVDExtraccion)SWDardeBaja.qvd](qvd);
Drop Table SWDardeBaja;
///$tab 5. Reporte_SNOW
Reporte_SNOW:
LOAD
    "Computer name",
    Organisation,
    Serial,
    "Last logged on user",
    "Application",
    "Application manufacturer",
    "Default metric",
    "License required",
    Installed,
    "Last scanned",
    Status


FROM [$(vRutaQVDExtraccionXlsx)Reporte_SNOW.xlsx]
(ooxml, embedded labels, table is [Applications per computer]);

Store Reporte_SNOW into [$(vRutaQVDExtraccion)Reporte_SNOW.qvd](qvd);
