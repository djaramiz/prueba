///$tab 3.2. PermisosAdministradorLocal
// MIGRACIÓN: archivo PermisosAdministradorLocal.xlsx → Gestion de Permisos de Administrador.xlsx
// Se eliminó EQUIPOS1 (no existe en nuevo archivo). Se agrega carga del tab Gestión Retiro permisos admin.
//PermisosAdministradorLocal:
//LOAD
//    EQUIPOS,
//    "# NUMERO DE ORDEN DE TRABAJO",
//    "CATEGORIA GRUPO DE TRABAJO",
//    "DOCUMENTACION/JUSTIFACION",
//    LOGIN,
//    EQUIPOS1,   // campo eliminado - no existe en nuevo archivo
//    VIGENCIA,
//    "WO RETIRO DE PERMISOS"
//FROM [lib://EPM_File_02 (epm_dcarmond)/Service_Desk/Remedy_epm/Auditoria/Evaluación vigente/PermisosAdministradorLocal.xlsx]
//(ooxml, embedded labels, table is [Gestion permisos administrador]);

PermisosAdministradorLocal:
LOAD
    "# NUMERO DE ORDEN DE TRABAJO",
    "CATEGORIA GRUPO DE TRABAJO",
    "DOCUMENTACION/JUSTIFACION",
    LOGIN,
    EQUIPOS,
    VIGENCIA,
    "WO RETIRO DE PERMISOS"
FROM [$(vRutaQVDExtraccionXlsx)Gestion de Permisos de Administrador.xlsx]
(ooxml, embedded labels, table is [Gestion permisos administrador]);

// Tab de retiro de permisos (mismos campos que asignación)
Concatenate (PermisosAdministradorLocal)
LOAD
    "# NUMERO DE ORDEN DE TRABAJO",
    "CATEGORIA GRUPO DE TRABAJO",
    "DOCUMENTACION/JUSTIFACION",
    LOGIN,
    EQUIPOS,
    VIGENCIA,
    "WO RETIRO DE PERMISOS"
FROM [$(vRutaQVDExtraccionXlsx)Gestion de Permisos de Administrador.xlsx]
(ooxml, embedded labels, table is [Gestión Retiro permisos admin]);

Store PermisosAdministradorLocal into [$(vRutaQVDExtraccion)PermisosAdministradorLocal.qvd](qvd);
Drop Table PermisosAdministradorLocal;




