JDESinSerialEN_CMDB_temp:
LOAD  Distinct Upper("Numero Serial") as "Numero Serial 2"
Resident informe_computer_system_all;

JDESinSerialEN_CMDB:
Load Distinct "Numero Serial JDE" AS "Numero Serial JDE 2",
			"Numero Serial JDE"
Resident Activos_OneWorld
WHERE not Exists("Numero Serial 2","Numero Serial JDE") AND Not IsNull("Numero Serial JDE");
Drop Table JDESinSerialEN_CMDB_temp;



CMDBSinSerialEN_JDE_temp:
LOAD  Distinct Upper("Numero Serial JDE") as "Numero Serial 3"
Resident Activos_OneWorld;

CMDBSinSerialEN_JDE:
LOAD  Distinct Upper("Numero Serial") as "Numero Serial 4",
	  "Numero Serial"
Resident informe_computer_system_all
WHERE not Exists("Numero Serial 3",Upper("Numero Serial")) AND Not IsNull("Numero Serial");
Drop Table CMDBSinSerialEN_JDE_temp;

















///$tab Sin Activo fijo
JDESinActivoEN_CMDB_temp:
LOAD  Distinct Upper("Numero Activo") as "Numero Activo 2"
Resident informe_computer_system_all;

JDESinActivoEN_CMDB:
Load Distinct "Numero Activo JDE" as "Numero Activo JDE 2",
     "Numero Activo JDE"	
Resident Activos_OneWorld
WHERE Not Exists("Numero Activo 2","Numero Activo JDE") AND Not IsNull("Numero Activo JDE");
Drop Table JDESinActivoEN_CMDB_temp;



CMDMSinActivoEN_JDE_temp:
Load Distinct Upper("Numero Activo JDE") as "Numero Activo JDE 3"
Resident Activos_OneWorld;

CMDMSinActivoEN_JDE:
LOAD  Distinct Upper("Numero Activo") as "Numero Activo 3",
	"Numero Activo" 
Resident informe_computer_system_all
WHERE not Exists("Numero Activo JDE 3",Upper("Numero Activo")) AND Not IsNull("Numero Activo");
Drop Table CMDMSinActivoEN_JDE_temp;









