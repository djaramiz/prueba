///$tab 1.3.  InventarioServidoresWindows
// MIGRACIÓN: Dominio eliminado → NombreServidor ahora es solo Servidor (hostname)
// Eliminados: DominioServidores, Agente SCCM, Agente MCM
// Nuevos campos: ip, power_state, ambiente, os_generico, ubicacion, origen, comunidad_principal
// AVISO: si AntivirusServidores.Name viene como FQDN (host.dominio), revisar cruce de cobertura
InventarioServidoresWindows:
LOAD
    Servidor,
    Servidor    as NombreServidor,
    ip,
    power_state,
    ambiente,
    OS,
    os_generico,
    ubicacion,
    origen,
    comunidad_principal
FROM [lib://EPM_File_02 (epm_dcarmond)/DGYD/DerechosAutor/QVD/Extracted/InventarioServidoresWindows.qvd]
(qvd);

Store InventarioServidoresWindows into [$(vRutaQVDTransformacion)InventarioServidoresWindows.qvd](qvd);
//Drop Table InventarioServidoresWindows;
///$tab 1.4. InventarioServidoresNoWindows
// MIGRACIÓN: campos actualizados (NOMBRE←name, AMBIENTE←ambiente, SISTEMA OPERATIVO←os, +ip, +power_state, +os_generico)
// Campos eliminados del QVD: DESCRIPCION, ROL, TIPO (no existen en nueva hoja NoWindows)
InventarioServidoresNoWindows:
LOAD
    NOMBRE,
    ip           as ip_NoWin,
    power_state  as power_state_NoWin,
    AMBIENTE,
    "SISTEMA OPERATIVO",
    os_generico  as os_generico_NoWin
FROM [lib://EPM_File_02 (epm_dcarmond)/DGYD/DerechosAutor/QVD/Extracted/InventarioServidoresNoWindows.qvd]
(qvd);

Store InventarioServidoresNoWindows into [$(vRutaQVDTransformacion)InventarioServidoresNoWindows.qvd](qvd);
//Drop Table InventarioServidoresNoWindows;
///$tab 2.1.CMDB_ContratosVsLicencias
// MIGRACIÓN: corregido "Fecha de Creacion" → "Fecha de Creación" (con tilde)
// Agregado: instanceId
CMDB_ContratosVsLicencias:
LOAD
    "Id del contrato de software",
    Nombre,
    instanceId,
    Estado,
    Fabricante as Fabricante_CMDB,
    IF(IsNull(Fabricante),'Sin_Fabricante') as  "Fabricante Desconocido",
    "Centro Actividad / Centro de Costos",
    "Suministrador Responsable",
    "Empresa Propietaria",
    "Fecha de Creación",
    "Fecha de Caducidad",
    IF(IsNull("Fecha de Caducidad"),'Sin_Fecha_Caducidad') as  "Fecha de Caducidad Nulo",
    "Fecha Modificada",
    Nombre_Producto,
    "Nombre Proveedor",
    IF(IsNull("Nombre Proveedor"),'Sin_Nombre_Proveedor') as  "Nombre Proveedor Nulo",
    "Orden de Compra",
    Clave__c,
    "Suma Número de Licencias Adquiridas",
    IF(IsNull("Suma Número de Licencias Adquiridas"),'Sin_LicenciasAdquiridas') as  "Licencias Adquiridas Nulo",
    Filial,
    //"Licencias Adquiridas",
    "Información Adicional / Descripción"
FROM [lib://EPM_File_02 (epm_dcarmond)/DGYD/DerechosAutor/QVD/Extracted/CMDB_ContratosVsLicencias.qvd]
(qvd)
Where Filial = 'EMPRESAS PUBLICAS DE MEDELLIN E.S.P'
AND "Empresa Propietaria" = 'EMPRESAS PUBLICAS DE MEDELLIN E.S.P'
AND Estado = 'Executed';

Store CMDB_ContratosVsLicencias into [$(vRutaQVDTransformacion)CMDB_ContratosVsLicencias.qvd](qvd);
//Drop Table CMDB_ContratosVsLicencias;


///$tab 2.2. FOTOSW_SCCM
FOTOSW_SCCM:
LOAD
    Nombre_Maquina,
    Serial,
    Dominio,
    Ultimo_Logon,
    Software,
    InstallDate0,
    Version0,
    Ultima_Revision
FROM [lib://EPM_File_02 (epm_dcarmond)/DGYD/DerechosAutor/QVD/Extracted/FOTOSW_SCCM.qvd]
(qvd);


Store FOTOSW_SCCM into [$(vRutaQVDTransformacion)FOTOSW_SCCM.qvd](qvd);
//Drop Table FOTOSW_SCCM;
//Exit script;
///$tab 2.3. SW_listablanca
// MIGRACIÓN: SW→SW_LB (antes mapeado directo), nuevos campos WO_LB, VersionEnRuta_LB, FechaRevision_LB, Estado_LB, URL_LB, Observaciones_LB
// Campos eliminados: Análisis_LB, FechaAnálisis_LB (reemplazados por FechaRevision_LB)
SW_listablanca:
LOAD
    SW as SW_LB,
    WO               as WO_LB,
    "VERSION EN RUTA" as VersionEnRuta_LB,
    "FECHA REVISION"  as FechaRevision_LB,
    ESTADO           as Estado_LB,
    URL              as URL_LB,
    Observaciones    as Observaciones_LB
FROM [lib://EPM_File_02 (epm_dcarmond)/DGYD/DerechosAutor/QVD/Extracted/SW_listablanca.qvd]
(qvd);

Store SW_listablanca into [$(vRutaQVDTransformacion)SW_listablanca.qvd](qvd);
//Drop Table SW_listablanca;
///$tab 2.4. SW_listanegra
// MIGRACIÓN: SW→SW_LN, nuevos campos WO_LN, Estado_LN, URL_LN, Observaciones_LN
// Campo eliminado: Observacion_LN (reemplazado por Observaciones_LN con contenido ampliado)
SW_listanegra:

LOAD
    SW as SW_LN,
    WO             as WO_LN,
    ESTADO         as Estado_LN,
    URL            as URL_LN,
    Observaciones  as Observaciones_LN
FROM [lib://EPM_File_02 (epm_dcarmond)/DGYD/DerechosAutor/QVD/Extracted/SW_listanegra.qvd]
(qvd);


Store SW_listanegra into [$(vRutaQVDTransformacion)SW_listanegra.qvd](qvd);
//Drop Table SW_listanegra;
