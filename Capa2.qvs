///$tab Licencias VS Fotos
LicenciasVSFotos_tepm:
Load Distinct UPPER (Nombre_Producto) as "Nombre_Producto 2"
Resident CMDB_ContratosVsLicencias;


LicenciasVSFotos:
LOAD Upper("Software") as "Software 2",
	 1 as 'Marca_sin_Licencia',
     "Software"
Resident FOTOSW_SCCM
WHERE not Exists("Nombre_Producto 2",Upper("Software"));



FotosVSLicencias_tepm:
LOAD Upper("Software") as "SoftwareFotos",
	 1 as 'Marca_sin_Licencia'
Resident FOTOSW_SCCM;

FotosVSLicencias:
Load Distinct UPPER (Nombre_Producto) as "Nombre_ProductoLicencia",
Nombre_Producto
Resident CMDB_ContratosVsLicencias
WHERE not Exists("SoftwareFotos", UPPER(Nombre_Producto));

Drop Table LicenciasVSFotos_tepm;
Drop Table FotosVSLicencias_tepm;
