///$tab 4. SWDardeBaja
// MIGRACIÓN: todos los campos cambiaron al nuevo formato del archivo SWDardeBaja.xlsx
// Campos eliminados (no disponibles): WOI_CI, Service, Product Cat Tier 1/2/3,
//   Service Cat Tier 1/2/3, Sequence, StatusReasonSelection, Customer First/Last Name, Business Service
// NOTA: WOI_CI era el CI vinculado a la WO - no tiene equivalente en el nuevo archivo.
//   El dashboard "Software dado de baja" necesita revisión para reemplazar o eliminar esa dimensión.
SWDardeBaja:
LOAD
    Tipo,
    "Work Order ID",
    "Task ID",
    "Status WO",
    Prioridad,
    "Submit Date",
    "Completed Date",
    "Mes apertura",
    "Año apertura",
    "Horas Laboradas",
    ASGRP,
    "Categorization Tier 1",
    "Categorization Tier 2",
    "Categorization Tier 3",
    Summary,
    Notes,
    Status,
    "Usuario Afectado",
    "Remedy Login ID",
    Company,
    "Assigned To",
    Assignee,
    "Assignee Group",
    Department,
    "Inicia Asignación Tarea",
    "Termina Asignación Tarea",
    "Notas OC",
    "Total Minutos Activo Tarea",
    "Total Horas Activo Tarea",
    "Total Horas Activo WO",
    "Última modificación"
FROM [lib://EPM_File_02 (epm_dcarmond)/DGYD/DerechosAutor/QVD/Extracted/SWDardeBaja.qvd]
(qvd);

Store SWDardeBaja into [$(vRutaQVDTransformacion)SWDardeBaja.qvd](qvd);
//Drop Table SWDardeBaja;
///$tab 5. Reporte_SNOW
Reporte_SNOW:
LOAD
    "Computer name",
    Organisation,
    Serial as SerialSNOW,
    "Last logged on user",
    "Application",
    "Application manufacturer",
    "Default metric",
    "License required",
    Installed,
    "Last scanned",
    Status as StatusSNOW


FROM [$(vRutaQVDExtraccion)Reporte_SNOW.qvd]
(qvd);

Store Reporte_SNOW into [$(vRutaQVDTransformacion)Reporte_SNOW.qvd](qvd);
//Drop Table Reporte_SNOW;


///$tab Cobertura Antivirus Endpoints
CoberturaAntivirus_tepm:
Load Distinct(Upper("Endpoint")) as "Endpoint 2"
Resident AntivirusPC;

sinAntivirus:
LOAD Upper("Nombre CI") as "Nombre CI 2",
	 1 as 'Marca_sin_antivirus',
     "Nombre CI"
Resident informe_computer_system_all
WHERE not Exists("Endpoint 2",Upper("Nombre CI"));

Drop Table CoberturaAntivirus_tepm;
///$tab Cobertura Antivirus servidores
servidoresAntivirus_temp:
Load Distinct(Upper("Name")) as "Name 2"
Resident AntivirusServidores;

sinservidoresAntivirus:
LOAD Upper("NombreServidor") as "NombreServidor 2",
	 1 as 'Marca_sin_antivirusServ',
     "NombreServidor"
Resident InventarioServidoresWindows
WHERE not Exists("Name 2",Upper("NombreServidor"));

Drop Table servidoresAntivirus_temp;





