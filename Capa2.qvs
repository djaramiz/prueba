///$tab 3.3. DA_Con_PermisosAdmonLocal
DA_Con_PermisosAdmonLocal:
LOAD
    "Nombre de directorio",
    "Nombre de directorio" as EQUIPOS,
    WO,
    IF(IsNull(WO),'Sin_WO') as  "sin WO",
