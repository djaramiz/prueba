///$tab Main
SET ThousandSep='.';
SET DecimalSep=',';
SET MoneyThousandSep='.';
SET MoneyDecimalSep=',';
SET MoneyFormat='$ #.##0;-$ #.##0';
SET TimeFormat='h:mm:ss TT';
SET DateFormat='D/MM/YYYY';
SET TimestampFormat='D/MM/YYYY h:mm:ss[.fff] TT';
SET FirstWeekDay=6;
SET BrokenWeeks=1;
SET ReferenceDay=0;
SET FirstMonthOfYear=1;
SET CollationLocale='es-CO';
SET CreateSearchIndexOnReload=1;
SET MonthNames='ene.;feb.;mar.;abr.;may.;jun.;jul.;ago.;sep.;oct.;nov.;dic.';
SET LongMonthNames='enero;febrero;marzo;abril;mayo;junio;julio;agosto;septiembre;octubre;noviembre;diciembre';
SET DayNames='lun.;mar.;mié.;jue.;vie.;sáb.;dom.';
SET LongDayNames='lunes;martes;miércoles;jueves;viernes;sábado;domingo';
SET NumericalAbbreviation='3:k;6:M;9:G;12:T;15:P;18:E;21:Z;24:Y;-3:m;-6:μ;-9:n;-12:p;-15:f;-18:a;-21:z;-24:y';


LET vRutaQVDExtraccion = '\\epm-file02\aplic\DGYD\DerechosAutor\QVD\Extracted\';//cargar
LET vRutaQVDTransformacion = '\\epm-file02\aplic\DGYD\DerechosAutor\QVD\Transformed\'; //guardar


///$tab 1.1. Activos_OneWorld
Activos_OneWorld:
LOAD
    "[FAASID] - Serial Number" as "Numero Serial JDE", //as "Numero Serial", // conexion con informe Computer system all
    IF(IsNull("[FAASID] - Serial Number"),'Sin_Numero_Serial_JDE') as  "Numero Serial Nulo JDE",
    "[FADSP] - Date Retired",
    "[FADSP] - Date Disposed or Retired",
    "[FANUMB] - Asset Number" as "Numero Activo JDE",
    IF(IsNull("[FANUMB] - Asset Number"),'Sin_Numero_Activo_JDE') as  "Numero Activo Nulo JDE",
    "[FAAAID] - Parent Number",
    "[FAAFE] - AFE Number",
    "[FAADDS] - State",
    "[FAAOBJ] - Asset Cost Account - Object",
    "[FADL01] - Description",
    "[FADL02] - Description 02",
    "[FADL03] - Description 03",
    "[FADSCC] - Compressed Description",
    "[FACO] - Company",
    "[FAAPID] - Unit Number",
    "[FASEQ] - Sequence Number",
    "[FAACL1] - Major Accounting Class",
    "[FAACL2] - Major Equipment Class",
    "[FAACL3] - Manufacturer",
    "[FAACL4] - Model Year",
    "[FAACL5] - Usage Miles or Hours",
    "[FADSUB] - Accum Depr Acct - Subsidiary",
    "[FAXMCU] - Depreciation Exp - BU",
    "[FAXOBJ] - Depreciation Exp - Object",
    "[FAXSUB] - Depreciation Exp - Subsidiary",
    "[FAJCD] - Contract Date",
    "[FADEXJ] - Date Expired",
    "[FAINSP] - Policy Number",
    "[FAINSC] - Insurance Company",
    "[FAINSM] - Renewal Month",
    "[FAINSA] - Insurance Premium",
    "[FAAIV] - Insurance Value",
    "[FAINSI] - Value Index (future)",
    "[FAUSER] - User ID",
    "[FALCT] - Date Last Changed",
    "[FAMCU] - Business Unit",
    "[FALOC] - Location",
    "[FADAJ] - Date Acquired",
    "[FAEQST] - Equipment Status",
    "[FANORU] - New or Used on Acquisition",
    "[FAAESV] - Estimated Salvage Value",
    "[FAARPC] - Replacement Cost",
    "[FAWOYN] - Allow Work Order",
    "[FACRTL] - Criticality",
    "[FAWRFL] - Warranty Flag",
    "[FAWARJ] - Warranty Expiration"
FROM [lib://EPM_File_02 (epm_dcarmond)/DGYD/DerechosAutor/QVD/Extracted/Activos_OneWorld.qvd]
(qvd)

// FROM [$(vRutaQVDExtraccion)informe_computer_system_all.qvd]
 Where "[FAAOBJ] - Asset Cost Account - Object" = 167002
 AND "[FADSP] - Date Retired" = 0
 AND MATCH ("[FADL01] - Description",'MICROCOMPUTADOR ESCRITORIO', 'MICROCOMPUTADOR PORTATIL')  ;


 Store Activos_OneWorld into [$(vRutaQVDTransformacion)Activos_OneWorld.qvd](qvd);
//Drop Table Activos_OneWorld;
//Store Activos_OneWorld into '\\epm-file02\aplic\DGYD\DerechosAutor\Activos_OneWorld.2025.csv'(txt,delimiter is ';');

///$tab 1.2. informe_computer_system_all
informe_computer_system_all:
LOAD
    Instancia,
    "Fecha de último examen",
    "Ultima Modificacion",
    "Numero Serial", // conexion con Activos_OneWorld
    IF(IsNull("Numero Serial"),'Sin_Numero_Serial') as  "Numero Serial Nulo",
    "Nombre CI",
    IF(IsNull("Nombre CI"),'Sin_Nombre_CI') as  "Nombre CI Nulo",
    "Numero Activo",
    Text("Numero Activo") AS "Numero Activo_2",
    IF(IsNull("Numero Activo"),'Sin_Numero_Activo') as  "Numero Activo Nulo",
    "Rol del sistema",
    "Estado Manual (Estado)",
    "Motivo Estado Manual",
    IF(IsNull("Motivo Estado Manual"),'Sin_Motivo_Estado_Manual') as  "Estado Nulo",
    "Estado CM",
    "Motivo del Estado CM",
    Categoria_Nivel_1,
    Tipo_Nivel_2,
    Item_Nivel_3,
    Modelo_Nombre_producto,
    IF(IsNull("Modelo_Nombre_producto"),'Sin_Modelo_Nombre_producto') as  "Modelo_Nulo",
    Fabricante as Fabricante_CSA,
    Contrato,
    "Empresa Suministradora",
    IF(IsNull("Empresa Suministradora"),'Sin_Empresa_Suministradora') as  "Empresa Suministradora Nulo",
    "Fecha Compra (Fecha adquisicion)",
    IF(IsNull("Fecha Compra (Fecha adquisicion)"),'Sin_Fecha_Compra') as  "Fecha Compra Nulo",
    "Fecha Inicio Garantia",
    IF(IsNull("Fecha Inicio Garantia"),'Sin_Fecha_Inicio_Garantia') as  "Fecha Inicio Garantia Nulo",
    "Fecha Fin Garantia",
    IF(IsNull("Fecha Fin Garantia"),'Sin_Fecha_Fin_Garantia') as  "Fecha Fin Garantia Nulo",
    "Fecha Inventario",
    "Fecha Repotenciacion",
    "Contacto Primario",
    IF(IsNull("Contacto Primario"),'Sin_Contacto_Primario') as  "Responsable Nulo",
    "Contacto Propietario",
    Cedula,
    LOGIN,
    Correo,
    "Centro de Costos",
    IF(IsNull("Centro de Costos"),'Sin_Centro_Costos') as  "Centro de Costos Nulo",
    "Nombre Centro de Costos",
    "Departamento CI",
    Organizacion,
    Empresa_Propietaria,
    Filial,
    "Region (Zona)",
    "Site Group (Grupo Ubicaciones)",
    "Site o Edificio (Ubicación)",
    IF(IsNull("Site o Edificio (Ubicación)"),'Sin_Sitio') as  "sitio Nulo",
    Piso,
    IF(IsNull(Piso),'Sin_Piso') as  "Piso Nulo",
    IF(IsNull(Piso),'Sin_Piso' or IsNull("Site o Edificio (Ubicación)"),'Sin_Sitio') as  "Sede Nulo",
    "Empresa Sede"
FROM [lib://EPM_File_02 (epm_dcarmond)/DGYD/DerechosAutor/QVD/Extracted/informe_computer_system_all.qvd]
(qvd)


//FROM [$(vRutaQVDExtraccion)informe_computer_system_all.qvd]
Where [Estado Manual (Estado)] = 'Activo'
AND [Estado CM] = 'Aplicado'
//AND WILDMATCH ("Motivo Estado Manual",'En Red','Sin Red','En Red (Reutilizado)', 'En PrÃ©stamo')
AND WILDMATCH (Item_Nivel_3,'Escritorio','Portatil','Terminal Liviana', 'Terminal Liviana Portatil')
AND Empresa_Propietaria = 'EMPRESAS PUBLICAS DE MEDELLIN E.S.P';


Store informe_computer_system_all into [$(vRutaQVDTransformacion)informe_computer_system_all.qvd](qvd);
//Drop Table informe_computer_system_all;
//Store informe_computer_system_all into '\\epm-file02\aplic\DGYD\DerechosAutor\informe_computer_system_all.2025.csv'(txt,delimiter is ';');


